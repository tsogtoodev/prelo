{
  "name": "@tsogtoodev/prelo",
  "version": "0.1.2",
  "description": "Preloading animations for Vue & Nuxt",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "vue",
    "nuxt",
    "preloader",
    "loading",
    "animation"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./style.css": "./dist/prelo.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "pnpm --filter playground dev",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@nuxt/kit": "^3.10.0 || ^4.0.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
